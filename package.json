{
  "name": "claude-tab-label",
  "version": "0.1.0",
  "description": "Tell your Claude Code terminals apart: label each tab with what it is working on now, not the first prompt",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seuthootDev/claude-tab-label.git"
  },
  "homepage": "https://github.com/seuthootDev/claude-tab-label#readme",
  "bugs": {
    "url": "https://github.com/seuthootDev/claude-tab-label/issues"
  },
  "type": "module",
  "bin": {
    "claude-tab-label": "dist/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/cli.ts --bundle --platform=node --target=node18 --format=esm --outfile=dist/cli.js --banner:js=\"#!/usr/bin/env node\"",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "claude-code",
    "terminal",
    "tab",
    "title",
    "session",
    "hook",
    "statusline"
  ]
}
